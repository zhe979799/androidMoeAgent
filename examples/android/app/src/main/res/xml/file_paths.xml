<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider may hand out: only diagnostic files under the app's own external files
     dir. Deliberately not the parent (which also holds downloaded multi-GB models) — a share sheet
     has no business being able to reach those. -->
<paths>
    <external-files-path
        name="metrics"
        path="metrics/" />
    <external-files-path
        name="agent_logs"
        path="agent-logs/" />
    <external-files-path
        name="inference_logs"
        path="inference-logs/" />
    <external-files-path
        name="diagnostic_bundles"
        path="diagnostic-bundles/" />
</paths>
